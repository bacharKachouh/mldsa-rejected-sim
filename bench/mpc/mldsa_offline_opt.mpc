# Offline phase of the open-w1 construction (paper, Section 9), OPTIMISED circuit. Same function and
# reveals as mldsa_offline_min.mpc. After the probabilistic quotient estimate, the remainder rp is
# opened ONCE under a statistical mask and everything else (two +q corrections, FIPS Decompose via
# the verified 15-bit identity) runs on its bits in the binary domain: w1 is the low 4 bits of t.
# Only 7 bits per coefficient come back to the arithmetic side (for r0 and w1).
#   F_nonce: y uniform on the FIPS box [-gamma1+1, gamma1] (one random 20-bit integer per coefficient)
#   F_w1:    w = A*y mod q (A public), w1 = HighBits(w) with the FIPS top-cell rule
# Reveals w1 of every attempt and nothing else. y and r0 = LowBits(w) stay secret and are
# persisted for the online program at position KEYLEN + j*SLOT.
# The K attempts are processed in parallel, as in the construction: all local (communication-free)
# arithmetic first, then one vectorised block of comparisons over the whole batch.
#
# Args: K [debug]. Public input (Programs/Public-Input/<progname>): A as k*l*n centered integers.
# 'debug' additionally reveals y and r0 for the correctness checks; never used for measurements.
from Compiler import comparison
program.use_edabit(True)
# probabilistic truncation (round with nearest=False): random bits + one opening, no comparison circuit

K = int(program.args[1])
debug = 'debug' in program.args[2:]

q, n, k, l = 8380417, 256, 6, 5
gamma1, gamma2 = 1 << 19, 261888
alpha = 2 * gamma2
KEYLEN = l * n + k * n
SLOT = l * n + k * n
OFFSET = q * (1 << 29)                     # multiple of q making A*y positive (|A*y| < 2^51.3)
S = 54                                      # w_off < 2^53.1 < 2^S
M = -(-(1 << S) // q)                       # ceil(2^S / q)
TRUNC_K = 85                                # bit length of w_off * M

A = cint.Array(k * l * n)
@for_range(k * l * n)
def _(i):
    A[i] = public_input()

# F_nonce for the whole batch
yall = sint.Array(K * l * n)
yall.assign(sint.get_random_int(20, size=K * l * n) - (gamma1 - 1))   # exactly uniform: 2*gamma1 = 2^20

# local: w_int = A*y over Z for every attempt and row
yext = sint.Array(l * 2 * n)                # per row j: [-y_j | y_j], for negacyclic shifts
wacc = sint.Array(n)
wall = sint.Array(K * k * n)

@for_range(K)
def _(att):
    sint.write_to_file([yall.get_vector(att * (l * n), l * n)], position=regint(KEYLEN) + att * SLOT)
    for j in range(l):
        yj = yall.get_vector(att * (l * n) + j * n, n)
        yext.assign_vector(-yj, j * 2 * n)
        yext.assign_vector(yj, j * 2 * n + n)
    for i in range(k):
        wacc.assign_all(0)
        @for_range(l * n)
        def _(jt):
            j = jt // n
            t = jt % n
            shifted = yext.get_vector(j * 2 * n + n - t, n)     # coefficients of X^t * y_j
            wacc.assign_vector(wacc.get_vector() + A[(i * l + j) * n + t] * shifted)
        wall.assign_vector(wacc.get_vector(), (att * k + i) * n)

# one vectorised block over K*k*n coefficients
V = K * k * n
SEC = program.security
W = 26                                                          # rp + 2^25 in [0, 2^26)

w_off = wall.get_vector() + OFFSET
Qp = (w_off * M).round(TRUNC_K, S, nearest=False, signed=False)
rp = w_off - q * Qp                                             # in [-2q, q)

# one masked opening of a = rp + 2^25, then a = (c - r) mod 2^W in binary
r_lo, rb = sint.get_edabit(W, True, size=V)
r_hi = sint.get_edabit(SEC, True, size=V)[0]
opening = (rp + (1 << 25) + r_lo + (r_hi << W)).reveal()
cb = rb[0].bit_decompose_clear(opening % (1 << W), W)


def sub_public_secret(pub, sec):
    """(pub - sec) mod 2^len, little-endian bit lists; one AND per bit."""
    out, borrow = [], None
    for i, (p, s) in enumerate(zip(pub, sec)):
        if borrow is None:
            out.append(s.bit_xor(p))
            borrow = s ^ (s & p)                                # borrow_1 = ~p & s  (public p)
            continue
        out.append(s.bit_xor(p).bit_xor(borrow))
        t_and = s & borrow
        t_or = s ^ borrow ^ t_and
        borrow = t_or ^ ((t_and ^ t_or) & p)
    return out


def add_secret_gated_const(x, const, g):
    """x + const * g mod 2^len (x secret bits, const public int, g secret bit)."""
    out, carry = [], None
    for i, xi in enumerate(x):
        yi = g if (const >> i) & 1 else None
        if carry is None:
            if yi is None:
                out.append(xi)
                continue
            out.append(xi ^ yi)
            carry = xi & yi
            continue
        if yi is None:
            out.append(xi ^ carry)
            carry = xi & carry
        else:
            s = xi ^ yi
            out.append(s ^ carry)
            carry = (xi & yi) ^ (carry & s)
    return out


def add_const(x, const):
    """x + const mod 2^len (public const); one AND per bit after the first set bit."""
    out, carry = [], None
    for i, xi in enumerate(x):
        ki = (const >> i) & 1
        if carry is None:
            if ki:
                out.append(xi.bit_not())
                carry = xi
            else:
                out.append(xi)
            continue
        if ki:
            out.append((xi ^ carry).bit_not())
            a = xi & carry
            carry = xi ^ carry ^ a                              # xi or carry
        else:
            out.append(xi ^ carry)
            carry = xi & carry
    return out


a = sub_public_secret(cb, rb[:W])
rpb = a[:25] + [a[25].bit_not()]                                      # two's complement of rp = a - 2^25
n1 = rpb[25]
rp1 = add_secret_gated_const(rpb, q, n1)
n2 = rp1[25]
rrb = add_secret_gated_const(rp1, q, n2)[:24]                   # rr in [0, q)
ub = add_const(rrb, gamma2 - 1)                                 # u = rr + gamma2 - 1 < 2^24 (drop carry)
vb = ub[9:24]                                                   # v = u >> 9, 15 bits
# s = v + (v >> 10) + 1
sb, carry = [], None
for i in range(15):
    y = vb[10 + i] if i < 5 else None
    if i == 0:
        s0 = vb[0] ^ y                                          # + (v>>10)_0, carry-in 1
        sb.append(s0.bit_not())
        carry = (vb[0] & y) ^ vb[0] ^ y                         # maj(v0, y0, 1) = v0 or y0
        continue
    if y is None:
        sb.append(vb[i] ^ carry)
        carry = vb[i] & carry
    else:
        s_ = vb[i] ^ y
        sb.append(s_ ^ carry)
        carry = (vb[i] & y) ^ (carry & s_)
sb.append(carry)                                                # bit 15
tb = sb[10:15]                                                  # t = s >> 10 in [0, 16]: 5 bits

conv = lambda b: sintbit.conv(b)
t_ar = sum(conv(tb[i]) * (1 << i) for i in range(5))
top = conv(tb[4])
w1 = t_ar - 16 * top                                            # = t mod 16
rr = rp + q * (conv(n1) + conv(n2))
r0all = sint.Array(K * k * n)
r0all.assign(rr - alpha * t_ar - top)

w1pub = cint.Array(K * k * n)
w1pub.assign(w1.reveal())

@for_range(K)
def _(att):
    sint.write_to_file([r0all.get_vector(att * (k * n), k * n)],
                       position=regint(KEYLEN) + att * SLOT + l * n)
    for i in range(k):
        print_ln('W1 %s %s %s', att, i, w1pub.get_vector((att * k + i) * n, n))
        if debug:
            print_ln('R %s %s %s', att, i, r0all.get_vector((att * k + i) * n, n).reveal())
    if debug:
        print_ln('Y %s %s', att, yall.get_vector(att * (l * n), l * n).reveal())
